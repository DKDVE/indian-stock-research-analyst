# Copy to .env and fill in values. Never commit .env.

# Data API — https://indianapi.in
INDIANAPI_KEY=YOUR_INDIANAPI_KEY_HERE

LLM_PROVIDER=openrouter
OPENROUTER_KEY=YOUR_OPENROUTER_KEY_HERE
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

ANTHROPIC_KEY=YOUR_ANTHROPIC_KEY_HERE

PORT=5001
FLASK_ENV=development

ENABLE_MARKET_DASHBOARD=true
ENABLE_PE_HISTORY=true
ENABLE_ANNOUNCEMENTS=true

# ── OpenAlgo integration (optional) ──────────────────────────
OPENALGO_HOST=http://localhost:5000
OPENALGO_API_KEY=
PANEL_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
