# Copy to .env and fill in values. Never commit .env.

# Data API — https://indianapi.in
INDIANAPI_KEY=YOUR_INDIANAPI_KEY_HERE

LLM_PROVIDER=openrouter
OPENROUTER_KEY=YOUR_OPENROUTER_KEY_HERE
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

ANTHROPIC_KEY=YOUR_ANTHROPIC_KEY_HERE

PORT=5001
FLASK_ENV=development

# Production (Render): default Gunicorn timeout is 30s; /api/brief streams longer and workers die.
# If your Web Service Start Command is only `gunicorn app:app --bind 0.0.0.0:$PORT` (Blueprint not applied),
# add this in Render → Environment (no Start Command change required):
# GUNICORN_CMD_ARGS=--worker-class gthread --threads 4 --timeout 300 --graceful-timeout 60

ENABLE_MARKET_DASHBOARD=true
ENABLE_PE_HISTORY=true
ENABLE_ANNOUNCEMENTS=true

# ── OpenAlgo integration (optional) ──────────────────────────
OPENALGO_HOST=http://localhost:5000
OPENALGO_API_KEY=
PANEL_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
